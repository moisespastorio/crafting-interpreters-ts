// Demonstrates closures
fun makeCounter() {
  var count = 0;
  fun counter() {
    count = count + 1;
    return count;
  }
  return counter;
}

var counter1 = makeCounter();
print counter1(); // 1
print counter1(); // 2

// Demonstrates classes, inheritance, this/super
class Animal {
  init(name) {
    this.name = name;
  }
  speak() {
    print this.name + " makes a sound.";
  }
}

class Dog < Animal {
  init(name) {
    super.init(name);
  }
  speak() {
    super.speak();
    print this.name + " barks.";
  }
}

var d = Dog("Rex");
d.speak();
